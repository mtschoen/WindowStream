<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.xr.immersive"
        android:required="false" />

    <application>
        <!-- UnifiedStreamingActivity is the new LAUNCHER: auto-discovers servers,
             provides a window drawer for dynamic open/close during streaming. -->
        <activity
            android:name=".demo.UnifiedStreamingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Legacy ServerSelectionActivity kept for backward compatibility
             but no longer the launcher. -->
        <activity
            android:name=".app.ServerSelectionActivity"
            android:exported="true" />
    </application>
</manifest>
